    "settings_usage_data" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Nutzungsdaten teilen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share anonymous usage data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir datos de uso anónimos"
          }
        }
