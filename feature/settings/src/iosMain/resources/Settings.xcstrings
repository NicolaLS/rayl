    },
    "settings_usage_data_off_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl teilt anonyme Zeitmessungen und Zähler, zum Beispiel wie lange eine Zahlung dauert. Niemals Beträge, Rechnungen oder etwas, das dich identifiziert. So finden wir Probleme und machen Rayl für dich besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl shares anonymous timings and counts, such as how long a payment takes. Never amounts, invoices, or anything that identifies you. This is how we find problems and make Rayl better for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl comparte tiempos y recuentos anónimos, por ejemplo cuánto tarda un pago. Nunca importes, facturas ni nada que te identifique. Así encontramos problemas y mejoramos Rayl para ti."
          }
        }
      }
    },
