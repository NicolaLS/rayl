        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PPQ.AI is a pay-per-use AI service: chat with leading models and generate images without a subscription, paid with Lightning. No account yet? The sign-up link is an affiliate link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PPQ.AI es un servicio de IA de pago por uso: chatea con modelos líderes y genera imágenes sin suscripción, pagando con Lightning. ¿Aún no tienes cuenta? El enlace de registro es un enlace de afiliado."
          }
        }
      }
