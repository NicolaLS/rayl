    "wallet_cards_add_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahle mit einer Wallet, die du schon hast. Rayl darf damit nur bezahlen; das Guthaben bleibt in dieser Wallet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay with a wallet you already have. Rayl only gets access to pay; the funds stay in that wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga con una billetera que ya tienes. Rayl solo puede pagar con ella; los fondos se quedan en esa billetera."
          }
        }
      }
    },
