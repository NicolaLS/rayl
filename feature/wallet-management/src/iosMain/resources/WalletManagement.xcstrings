    "wallet_removal_failed" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wallet konnte nicht vollständig getrennt werden. Versuche es erneut, um zu Rayl zurückzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This wallet could not be completely disconnected. Try again to go back to Rayl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta billetera no se pudo desconectar por completo. Vuelve a intentarlo para volver a Rayl."
          }
        }
      }
    },
    "wallet_removal_payment_active" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zahlung wird gesendet. Warte auf die Antwort, bevor du die Wallet wechselst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A payment is being submitted. Wait for the response before switching wallets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está enviando un pago. Espera la respuesta antes de cambiar de billetera."
          }
        }
      }
    },
    "wallet_removal_payment_warning" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird diese Wallet getrennt und ihre lokalen Zahlungsdaten werden gelöscht. Um sie wieder zu verwenden, verbinde sie erneut. Prüfe bei ausstehenden Zahlungen oder unbekanntem Ergebnis zuerst diese Wallet; das Trennen storniert keine Zahlung. Kontakte, Einstellungen und Hub-Verknüpfungen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This disconnects this wallet and erases its local payment records. To use it again, connect it again. If a payment is pending or its outcome is unknown, check this wallet before trying again; disconnecting does not cancel a payment. Your contacts, preferences and Hub shortcuts are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desconecta esta billetera y borra sus registros de pago locales. Para volver a usarla, conéctala de nuevo. Si un pago está pendiente o su resultado es desconocido, revisa esta billetera antes de volver a intentarlo; desconectarla no cancela ningún pago. Tus contactos, preferencias y accesos directos del Hub se conservan."
          }
        }
      }
    },
    "wallet_removal_retry" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
