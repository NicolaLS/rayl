    "blink_onboarding_add_wallet_title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde deine Blink-Wallet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your Blink wallet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta tu billetera Blink"
          }
        }
      }
    },
    "blink_onboarding_agreement_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzung von %1$@ erfolgt auf eigenes Risiko. Diese App verbindet sich mit deiner eigenen Lightning-Wallet — du bist vollständig verantwortlich für die Gelder in deiner Wallet und alle getätigten Zahlungen.\n\nWir empfehlen dringend, Wallets mit kleinem Guthaben zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using %1$@ is at your own risk. This app connects to your own Lightning wallet — you are fully responsible for the funds in your wallet and any payments made.\n\nWe strongly recommend connecting wallets with small spending balances."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar %1$@ es bajo tu propio riesgo. Esta app se conecta a tu propia billetera Lightning — eres totalmente responsable de los fondos en tu billetera y de cualquier pago realizado.\n\nRecomendamos encarecidamente conectar billeteras con saldos pequeños."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
