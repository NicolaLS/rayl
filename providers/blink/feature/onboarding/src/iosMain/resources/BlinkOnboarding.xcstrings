    "blink_onboarding_add_wallet_intro" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folge diesen vier Schritten im Blink-Dashboard. %1$@ benötigt Lese- und Schreibzugriff, um deine Wallet zu prüfen und Zahlungen zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow these four steps in the Blink dashboard. %1$@ needs Read and Write access to check your wallet and send payments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue estos cuatro pasos en el panel de Blink. %1$@ necesita acceso de Lectura y Escritura para consultar tu billetera y enviar pagos."
          }
        }
      }
    },
    "blink_onboarding_add_wallet_next_step" : {
