    "rayl_erase_pocket_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in Debug-Builds. Löscht den Rayl-Schlüssel und die Wallet-Daten dieses Geräts. Dein Passkey richtet sie wieder ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug builds only. Deletes this device's Rayl key and wallet data. Your passkey sets them up again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en compilaciones de depuración. Borra la clave de Rayl y los datos de la billetera de este dispositivo. Tu passkey los configura de nuevo."
          }
        }
      }
    },
