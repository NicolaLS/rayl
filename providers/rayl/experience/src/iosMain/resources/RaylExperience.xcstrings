    "rayl_erase_pocket_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in Debug-Builds. Löscht den Rayl-Schlüssel dieses Geräts und alles Guthaben darauf endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug builds only. Permanently deletes this device's Rayl key and any funds on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en compilaciones de depuración. Borra de forma permanente la clave de Rayl de este dispositivo y todos sus fondos."
          }
        }
      }
    },
