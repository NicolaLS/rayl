      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl konnte die Sitzung nicht beenden. Versuche es erneut, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl couldn't close its session. Retry to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl no pudo cerrar la sesión. Reintenta para continuar."
          }
        }
      }
    },
    "rayl_onboarding_agreement_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzung von Rayl erfolgt auf eigenes Risiko. Dein Rayl-Guthaben ist durch einen Passkey geschützt, den Rayl beim Fortfahren erstellt oder öffnet: Wenn du diesen Passkey löschst, ist das Guthaben verloren. Du bist für das Guthaben und alle Zahlungen voll verantwortlich.\n\nBehalte nur kleine Beträge, die du ausgeben willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using Rayl is at your own risk. Your Rayl balance is protected by a passkey, which Rayl creates or opens when you continue: if you delete that passkey, the balance is lost. You are fully responsible for the funds and any payments made.\n\nKeep only small amounts you plan to spend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar Rayl es bajo tu propio riesgo. Tu saldo de Rayl está protegido por una passkey, que Rayl crea o abre al continuar: si borras esa passkey, el saldo se pierde. Eres totalmente responsable de los fondos y de los pagos realizados.\n\nGuarda solo importes pequeños que pienses gastar."
          }
        }
      }
    },
    "rayl_passkey_failed" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passkey konnte nicht geöffnet werden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't open your passkey. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir tu passkey. Inténtalo de nuevo."
          }
        }
      }
    },
    "rayl_passkey_unavailable_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Telefon kann keine Passkeys verwenden, daher kann Rayl hier kein Guthaben führen. Zahle stattdessen mit einer Wallet, die du schon hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone can't use passkeys, so Rayl can't keep a balance here. Pay with a wallet you already have instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono no puede usar passkeys, así que Rayl no puede guardar un saldo aquí. Paga con una billetera que ya tengas."
          }
        }
      }
    },
