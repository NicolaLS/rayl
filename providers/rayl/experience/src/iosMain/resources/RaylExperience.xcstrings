    "rayl_leave_failed" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl konnte die Sitzung nicht beenden. Versuche es erneut, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl couldn't close its session. Retry to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl no pudo cerrar la sesión. Reintenta para continuar."
          }
        }
      }
    },
    "rayl_onboarding_agreement_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzung von Rayl erfolgt auf eigenes Risiko. Dein Rayl-Guthaben wird nur auf diesem Gerät gespeichert und nicht gesichert: Wenn du dieses Telefon verlierst oder zurücksetzt, ist das Guthaben verloren. Du bist für das Guthaben und alle Zahlungen voll verantwortlich.\n\nBehalte nur kleine Beträge, die du ausgeben willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using Rayl is at your own risk. Your Rayl balance is stored only on this device and is not backed up: if you lose or reset this phone, the balance is lost. You are fully responsible for the funds and any payments made.\n\nKeep only small amounts you plan to spend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar Rayl es bajo tu propio riesgo. Tu saldo de Rayl se guarda solo en este dispositivo y no tiene copia de seguridad: si pierdes o restableces este teléfono, el saldo se pierde. Eres totalmente responsable de los fondos y de los pagos realizados.\n\nGuarda solo importes pequeños que pienses gastar."
          }
        }
      }
    },
    "rayl_onboarding_autopay_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wann Rayl vor dem Bezahlen um Bestätigung bitten soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose when Rayl should ask for confirmation before paying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuándo Rayl debe pedir confirmación antes de pagar."
          }
        }
      }
    },
    "rayl_onboarding_page1_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl scannt im Hintergrund, damit der Bezahlvorgang flüssig bleibt. Richte die Kamera auf den Code, warte kurz, und fertig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl scans in the background so checkout stays smooth. Aim at the code, wait a beat, and you’re good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayl escanea en segundo plano para que el pago sea fluido. Apunta al código, espera un momento y listo."
          }
        }
      }
    },
    "rayl_onboarding_page1_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er arbeitet – auch wenn du die Kamera nicht siehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s working — even if you can’t see the camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona, aunque no veas la cámara."
          }
        }
      }
    },
    "rayl_onboarding_page1_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiser Scanner, schnelle Ergebnisse"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiet scanner, quick results"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escáner silencioso, resultados rápidos"
          }
        }
      }
    },
    "rayl_onboarding_page2_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege ein Limit fest, mit dem du dich wohlfühlst. Bei allem darüber fragt Rayl vor dem Bezahlen nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a limit you’re comfortable with. For anything above it, Rayl will ask before paying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija un límite con el que te sientas cómodo. Por encima de él, Rayl te preguntará antes de pagar."
          }
        }
      }
    },
    "rayl_onboarding_page2_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Beträge sofort bezahlen – ohne zusätzliches Tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay small amounts instantly — no extra taps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga importes pequeños al instante, sin toques extra."
          }
        }
      }
    },
    "rayl_onboarding_page2_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Pay nach deinen Regeln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Pay, your rules"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Pay, a tu manera"
          }
        }
      }
    },
    "rayl_onboarding_page3_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Rayl aus der Wallet auf, in der du sparst, und behalte nur, was du ausgeben willst. Deine Ersparnisse bleiben, wo sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top up Rayl from the wallet you save in, and keep only what you plan to spend. Your savings stay where they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recarga Rayl desde la billetera donde ahorras y guarda solo lo que piensas gastar. Tus ahorros se quedan donde están."
          }
        }
      }
    },
    "rayl_onboarding_page3_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie eine Prepaid-Karte für Lightning."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a prepaid card for Lightning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como una tarjeta prepago para Lightning."
          }
        }
      }
    },
    "rayl_onboarding_page3_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
