    "rayl_accounts_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passkey hat bereits Konten, vielleicht aus anderen Apps. Zahle mit einem davon oder starte ein neues nur für Rayl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your passkey already has accounts, maybe from other apps. Pay from one of them, or start a new one just for Rayl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu passkey ya tiene cuentas, quizá de otras apps. Paga con una de ellas o crea una nueva solo para Rayl."
          }
        }
      }
    },
