    "spark_wallet_passphrase_note" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn deine Wallet mit einer erstellt wurde, manchmal 25. Wort genannt. Groß- und Kleinschreibung zählen, und eine andere Passphrase öffnet eine andere, leere Wallet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if your wallet was created with one, sometimes called a 25th word. It is case-sensitive, and a different passphrase opens a different, empty wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si tu billetera se creó con una, a veces llamada la palabra 25. Distingue mayúsculas de minúsculas, y una frase distinta abre otra billetera vacía."
          }
        }
      }
    },
