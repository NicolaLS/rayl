#!/usr/bin/env bash

STACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${STACK_DIR}/docker-compose.yml"

RAYL_NWC_PROJECT="${RAYL_NWC_PROJECT:-rayl-nwc}"
RAYL_NWC_BIND_HOST="${RAYL_NWC_BIND_HOST:-127.0.0.1}"
RAYL_NWC_RELAY_PORT="${RAYL_NWC_RELAY_PORT:-8081}"
RAYL_NWC_HELPER_PORT="${RAYL_NWC_HELPER_PORT:-8082}"
RAYL_NWC_PUBLIC_RELAY_URL="${RAYL_NWC_PUBLIC_RELAY_URL:-ws://127.0.0.1:${RAYL_NWC_RELAY_PORT}}"
RAYL_NWC_ANDROID_RELAY_URL="${RAYL_NWC_ANDROID_RELAY_URL:-ws://10.0.2.2:${RAYL_NWC_RELAY_PORT}}"
RAYL_NWC_IOS_RELAY_URL="${RAYL_NWC_IOS_RELAY_URL:-ws://127.0.0.1:${RAYL_NWC_RELAY_PORT}}"
TEST_WALLET_SERVICE_URL="${TEST_WALLET_SERVICE_URL:-http://127.0.0.1:${RAYL_NWC_HELPER_PORT}}"

export RAYL_NWC_PROJECT
export RAYL_NWC_BIND_HOST
export RAYL_NWC_RELAY_PORT
export RAYL_NWC_HELPER_PORT
export RAYL_NWC_PUBLIC_RELAY_URL

require_command() {
  local name="$1"
  if ! command -v "$name" >/dev/null 2>&1; then
    echo "$name is required" >&2
    exit 127
  fi
}

compose() {
  docker compose -p "$RAYL_NWC_PROJECT" -f "$COMPOSE_FILE" "$@"
}

write_export() {
  local name="$1"
  local value="$2"
  printf 'export %s=%q\n' "$name" "$value"
}

write_env() {
  local env_file="${RAYL_NWC_ENV_FILE:-${STACK_DIR}/.env.local}"
  local tmp
  tmp="$(mktemp "${env_file}.tmp.XXXXXX")"
  {
    printf '# Generated by tools/nwc-stack/bin/up. Do not edit or commit.\n'
    write_export RAYL_NWC_PROJECT "$RAYL_NWC_PROJECT"
    write_export RAYL_NWC_RELAY_PORT "$RAYL_NWC_RELAY_PORT"
    write_export RAYL_NWC_HELPER_PORT "$RAYL_NWC_HELPER_PORT"
    write_export TEST_WALLET_SERVICE_URL "$TEST_WALLET_SERVICE_URL"
    write_export TEST_NWC_RELAY_URL "$RAYL_NWC_PUBLIC_RELAY_URL"
    write_export TEST_NWC_RELAY_ANDROID_URL "$RAYL_NWC_ANDROID_RELAY_URL"
    write_export TEST_NWC_RELAY_IOS_URL "$RAYL_NWC_IOS_RELAY_URL"
    if [[ -n "${TEST_NWC_RELAY_DEVICE_URL:-}" ]]; then
      write_export TEST_NWC_RELAY_DEVICE_URL "$TEST_NWC_RELAY_DEVICE_URL"
    fi
  } >"$tmp"
  mv "$tmp" "$env_file"
}

load_env() {
  local env_file="${RAYL_NWC_ENV_FILE:-${STACK_DIR}/.env.local}"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

export_maestro_env() {
  export TEST_WALLET_SERVICE_URL="${TEST_WALLET_SERVICE_URL:-http://127.0.0.1:${RAYL_NWC_HELPER_PORT}}"
  export TEST_NWC_RELAY_URL="${TEST_NWC_RELAY_URL:-$RAYL_NWC_PUBLIC_RELAY_URL}"
  export TEST_NWC_RELAY_ANDROID_URL="${TEST_NWC_RELAY_ANDROID_URL:-$RAYL_NWC_ANDROID_RELAY_URL}"
  export TEST_NWC_RELAY_IOS_URL="${TEST_NWC_RELAY_IOS_URL:-$RAYL_NWC_IOS_RELAY_URL}"
}

helper_url() {
  printf '%s\n' "${TEST_WALLET_SERVICE_URL:-http://127.0.0.1:${RAYL_NWC_HELPER_PORT}}"
}
