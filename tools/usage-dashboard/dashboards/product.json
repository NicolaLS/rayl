{
  "uid": "rayl-product",
  "title": "Rayl: Product",
  "tags": [
    "rayl"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "platform",
        "label": "Platform",
        "type": "custom",
        "query": "android,ios",
        "multi": true,
        "includeAll": true,
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "android",
            "value": "android",
            "selected": false
          },
          {
            "text": "ios",
            "value": "ios",
            "selected": false
          }
        ],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "rayl"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Rayl"
    }
  ],
  "panels": [
    {
      "type": "bargauge",
      "title": "New users: how far they get",
      "id": 1,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "Fresh installs only; each is counted once per step. The biggest drop between two bars is where new users get stuck.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select step, installs from (\n  select case dimensions->>'step'\n      when 'welcome' then '1 Opened the app' when 'app_onboarded' then '2 Finished the intro'\n      when 'wallet_ready' then '3 Wallet ready' when 'funded' then '4 Added funds' when 'first_payment' then '5 Paid once' end as step,\n    count(*) as installs\n  from telemetry_events where name = 'onboarding' and $__timeFilter(received_hour) and platform in (${platform:sqlstring}) group by 1\n) steps order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "type": "table",
      "title": "Fake doors: who wanted it",
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "Installs, not taps: each person counts once. Empty until the first fake door ships.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select dimensions->>'door' as door,\n  count(*) filter (where dimensions->>'action' = 'shown') as \"saw it\",\n  count(*) filter (where dimensions->>'action' = 'tapped') as \"tapped it\",\n  round(100.0 * count(*) filter (where dimensions->>'action' = 'tapped') / nullif(count(*) filter (where dimensions->>'action' = 'shown'), 0), 1) as \"interested %\"\nfrom telemetry_events where name = 'fake_door' and $__timeFilter(received_hour) and platform in (${platform:sqlstring}) group by 1 order by 2 desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "piechart",
      "title": "How payments start",
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "scan = camera. input = pasted or typed. hub = started from a contact or shortcut in the Hub.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select dimensions->>'source' as source, count(*) as payments from telemetry_events where name = 'payment' and dimensions->>'outcome' = 'paid' and $__timeFilter(received_hour) and platform in (${platform:sqlstring}) group by 1 order by 2 desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      }
    },
    {
      "type": "piechart",
      "title": "How payments are confirmed",
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "auto = paid without asking (Auto Pay). confirmed = the user tapped to confirm. amount entered = the user typed the amount.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select replace(dimensions->>'confirmation', '_', ' ') as confirmation, count(*) as payments from telemetry_events where name = 'payment' and dimensions->>'outcome' = 'paid' and $__timeFilter(received_hour) and platform in (${platform:sqlstring}) group by 1 order by 2 desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      }
    },
    {
      "type": "bargauge",
      "title": "Settings people change",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "Counted once per app session and setting. A setting that many people change may have the wrong default.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select replace(dimensions->>'setting', '_', ' ') as setting, count(*) as times from telemetry_events where name = 'setting_changed' and $__timeFilter(received_hour) and platform in (${platform:sqlstring}) group by 1 order by 2 desc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "type": "row",
      "title": "Sharing usage data",
      "id": 6,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Asked to turn it off",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "How often someone flipped the switch off and saw the question.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) filter (where dimensions->>'choice' = 'asked') from telemetry_events where name = 'usage_data_choice' and $__timeFilter(received_hour) and platform in (${platform:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Kept it on",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "Saw the question and decided to keep sharing.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 5,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) filter (where dimensions->>'choice' = 'kept_on') from telemetry_events where name = 'usage_data_choice' and $__timeFilter(received_hour) and platform in (${platform:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Turned it off",
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "Asked minus kept on. Rayl sends nothing once someone turns it off, so this is worked out, not reported. Slightly approximate.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select greatest(count(*) filter (where dimensions->>'choice' = 'asked') - count(*) filter (where dimensions->>'choice' = 'kept_on'), 0) from telemetry_events where name = 'usage_data_choice' and $__timeFilter(received_hour) and platform in (${platform:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Turned it on again",
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "Came back after having turned it off.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) filter (where dimensions->>'choice' = 'turned_on_again') from telemetry_events where name = 'usage_data_choice' and $__timeFilter(received_hour) and platform in (${platform:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Off right now (roughly)",
      "id": 11,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "Turned off minus turned on again, within the selected period. Pick a long time range for the total.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select greatest(count(*) filter (where dimensions->>'choice' = 'asked') - count(*) filter (where dimensions->>'choice' = 'kept_on') - count(*) filter (where dimensions->>'choice' = 'turned_on_again'), 0) from telemetry_events where name = 'usage_data_choice' and $__timeFilter(received_hour) and platform in (${platform:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "type": "row",
      "title": "Adoption",
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "App opens per day, by version",
      "id": 13,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "How much the app is used and how fast a new version is taken up.",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select date_trunc('day', received_hour) as time, platform || ' ' || app_version as metric, count(*) as value\nfrom telemetry_events where name = 'launch' and $__timeFilter(received_hour) and platform in (${platform:sqlstring}) group by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "table",
      "title": "Phones and system versions",
      "id": 14,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rayl-usage-data"
      },
      "description": "What people actually run Rayl on; a guide for what to test.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rayl-usage-data"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select platform, device_model as phone, os_major as \"system (API level on Android)\", count(*) as \"app opens\"\nfrom telemetry_events where name = 'launch' and $__timeFilter(received_hour) and platform in (${platform:sqlstring}) group by 1, 2, 3 order by 4 desc limit 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
