#!/bin/sh
# Creates the read-only database role Grafana uses and writes its connection to .env (gitignored).
# Needs the Railway CLI (logged in), psql, and a public TCP proxy on the Postgres service:
# Railway dashboard -> rayl-backend -> Postgres -> Settings -> Networking -> TCP Proxy, port 5432.
# Run it again to rotate the role's password.
set -eu
cd "$(dirname "$0")"
PSQL="$(command -v psql || echo "$(brew --prefix libpq)/bin/psql")"
URL=$(railway variable list -p 9bbf2625-4edc-4a92-bc7c-b3e9f6c840be -e production -s Postgres --json |
  python3 -c "import json,sys; print(json.load(sys.stdin).get('DATABASE_PUBLIC_URL', ''))")
if [ -z "$URL" ]; then
  echo "The Postgres service has no public endpoint yet; add the TCP proxy first (see above)." >&2
  exit 1
fi
PASSWORD=$(openssl rand -hex 24)
"$PSQL" "$URL" -v ON_ERROR_STOP=1 -q <<SQL
do \$\$ begin
  if not exists (select from pg_roles where rolname = 'grafana_reader') then
    create role grafana_reader login;
  end if;
end \$\$;
alter role grafana_reader password '$PASSWORD';
grant usage on schema public to grafana_reader;
grant select on telemetry_events, telemetry_daily_counts, telemetry_daily_measures to grafana_reader;
SQL
python3 - "$URL" "$PASSWORD" <<'PY'
import sys, urllib.parse
url = urllib.parse.urlparse(sys.argv[1])
with open(".env", "w") as env:
    env.write(
        f"RAYL_DB_HOST={url.hostname}\nRAYL_DB_PORT={url.port}\nRAYL_DB_NAME={url.path.lstrip('/')}\n"
        f"RAYL_DB_USER=grafana_reader\nRAYL_DB_PASSWORD={sys.argv[2]}\nRAYL_DB_SSLMODE=require\n"
    )
PY
chmod 600 .env
echo "Wrote .env. Start the dashboard with: docker compose up -d"
