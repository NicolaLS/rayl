#!/usr/bin/env bash
# Starts Blink's backend on regtest (Blink's quickstart, ~30 containers) with an outside
# Lightning node that has a channel to Blink. Every start is from scratch.
set -euo pipefail
source "$(dirname "$0")/_common"

require_command docker
require_command git
require_command jq
require_command curl

if ! docker info >/dev/null 2>&1; then
  echo "Docker or OrbStack must be running before starting the Blink stack." >&2
  exit 1
fi

if [[ "$(git -C "$WORK_DIR/src" rev-parse HEAD 2>/dev/null || true)" != "$BLINK_REF" ]]; then
  echo "Fetching Blink's quickstart at ${BLINK_REF:0:9}..."
  rm -rf "$WORK_DIR"
  mkdir -p "$WORK_DIR/src" "$WORK_DIR/vendor"
  git -C "$WORK_DIR/src" init -q
  git -C "$WORK_DIR/src" remote add origin https://github.com/GaloyMoney/blink.git
  git -C "$WORK_DIR/src" sparse-checkout set quickstart
  git -C "$WORK_DIR/src" fetch -q --depth 1 --filter=blob:none origin "$BLINK_REF"
  git -C "$WORK_DIR/src" checkout -q FETCH_HEAD
  cp -R "$WORK_DIR/src/quickstart" "$QUICKSTART_DIR"
fi

compose down --remove-orphans --volumes >/dev/null 2>&1 || true
compose up -d --quiet-pull

# Blink's own script mines the first blocks and starts Bria.
(cd "$WORK_DIR" && vendor/blink-quickstart/bin/init-onchain.sh >/dev/null)

# The channel outside -> Blink. Blink's init-lightning.sh tries without waiting for LND to sync and
# often fails. The opening pushes 2M sats to Blink's side: LND can't send until its side holds
# more than the channel reserve (1%), and Blink then refuses payments as
# InsufficientBalanceForLnPayment.
bitcoin() { docker exec "${COMPOSE_PROJECT_NAME}-bitcoind-1" bitcoin-cli "$@"; }
lnd_blink() {
  docker exec "${COMPOSE_PROJECT_NAME}-lnd1-1" lncli \
    --macaroonpath /root/.lnd/data/chain/bitcoin/regtest/admin.macaroon \
    --tlscertpath /root/.lnd/tls.cert "$@"
}
wait_until() {
  local what="$1" tries="$2"
  shift 2
  for _ in $(seq 1 "$tries"); do
    "$@" >/dev/null 2>&1 && return
    sleep 2
  done
  echo "Timed out waiting for $what" >&2
  exit 1
}
synced() { [[ "$("$1" getinfo | jq -r .synced_to_chain)" == "true" ]]; }
channel_active() { [[ "$(lnd_outside listchannels | jq '[.channels[] | select(.active)] | length')" -gt 0 ]]; }

echo "Opening a channel to Blink..."
wait_until "Blink's LND to sync" 90 synced lnd_blink
wait_until "the outside LND to sync" 90 synced lnd_outside
bitcoin sendtoaddress "$(lnd_outside newaddress p2wkh | jq -r .address)" 1 >/dev/null
bitcoin -generate 3 >/dev/null
blink_node="$(lnd_blink getinfo | jq -r .identity_pubkey)"
lnd_outside connect "${blink_node}@${COMPOSE_PROJECT_NAME}-lnd1-1:9735" >/dev/null 2>&1 || true
wait_until "the channel to open" 30 \
  lnd_outside openchannel --node_key "$blink_node" --local_amt 10000000 --push_amt 2000000
bitcoin -generate 6 >/dev/null
wait_until "the channel to become active" 60 channel_active

echo "Waiting for Blink's API..."
for _ in $(seq 1 90); do
  network="$(graphql "" 'query { globals { network } }' | jq -r '.data.globals.network // empty' 2>/dev/null || true)"
  [[ "$network" == "regtest" ]] && break
  sleep 2
done
if [[ "${network:-}" != "regtest" ]]; then
  echo "Blink's API did not come up at $RAYL_BLINK_API_URL" >&2
  exit 1
fi

# Blink creates invoices a little after its API answers. Ready means a user can be funded.
echo "Waiting until Blink takes payments..."
for attempt in $(seq 1 36); do
  "$(dirname "$0")/fixture" user 1000 >/dev/null 2>&1 && break
  if ((attempt == 36)); then
    echo "Blink did not take a payment within 3 minutes:" >&2
    "$(dirname "$0")/fixture" user 1000 >/dev/null
    exit 1
  fi
  sleep 5
done

{
  echo "# Generated by tools/blink-stack/bin/up. Do not edit or commit."
  printf 'export RAYL_BLINK_API_URL=%q\n' "$RAYL_BLINK_API_URL"
  printf 'export RAYL_BLINK_PROJECT=%q\n' "$COMPOSE_PROJECT_NAME"
} >"$STACK_DIR/.env.local"

echo "Local Blink stack is ready at $RAYL_BLINK_API_URL (regtest)."
echo "  ./gradlew :providers:blink:integration:blink:walletIntegrationTest"
